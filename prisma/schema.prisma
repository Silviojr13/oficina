generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Produto {
  id                     String                     @id @default(cuid())
  nome                   String
  slug                   String                     @unique
  sku                    String                     @unique
  codigoOEM              String?
  codigoBarras           String?
  ncm                    String?
  cest                   String?
  referenciaCruzada      String?
  marca                  String
  fabricanteOriginal     String?
  paisOrigem             String?
  tipoAplicacao          String
  tipoPeca               String
  categoria              String
  subcategoria           String?
  tags                   String?
  localizacaoEstoque     String?
  setorAlmoxarifado      String?
  pesoBruto              Float?
  pesoLiquido            Float?
  comprimento            Float?
  largura                Float?
  altura                 Float?
  unidadeMedida          String?
  conteudoEmbalagem      Int?
  material               String?
  cor                    String?
  garantia               String?
  fichaTecnicaUrl        String?
  manualUrl              String?
  custoAquisicao         Float?
  freteEntrada           Float?
  impostosEntrada        Float?
  custoTotal             Float                      @default(0)
  margemLucro            Float?
  precoVendaSugerido     Float?
  precoVendaBalcao       Float?
  precoB2B               Float?
  precoMinimo            Float?
  descontoMaximo         Float?
  precoSite              Float?
  precoPromocional       Float?
  dataInicioPromocao     DateTime?
  dataFimPromocao        DateTime?
  exibirNoSite           Boolean                    @default(false)
  // false = arquivado ("saiu de linha"): some do estoque, das buscas e da
  // loja, mas continua nas vendas, compras e OS antigas. Produto com
  // historico nao pode ser excluido, so arquivado.
  ativo                  Boolean                    @default(true)
  destaqueHome           Boolean                    @default(false)
  aliquotaICMS           Float?
  aliquotaIPI            Float?
  cstCsosn               String?
  pisCofins              Float?
  regimeTributacao       String?
  estoqueAtual           Int                        @default(0)
  estoqueMinimo          Int?
  estoqueMaximo          Int?
  estoqueSeguranca       Int?
  controlaEstoque        Boolean                    @default(true)
  permiteVendaSemEstoque Boolean                    @default(false)
  fornecedorPadraoId     String?
  prazoReposicao         Int?
  fotos                  String?
  imagemPrincipal        String?
  descricaoCurta         String?
  descricaoCompleta      String?
  caracteristicas        String?
  videoUrl               String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  mercadoLivreId         String?
  mercadoLivreStatus     String?
  mercadoLivreErro       String?
  mercadoLivreSyncEm     DateTime?
  entradasEstoque        ItemMovimentacao_entrada[]
  saidasEstoque          ItemMovimentacao_saida[]
  veiculosCompativeis    VeiculoCompativel[]
  itensOrdemServico      ItemOrdemServico[]

  @@index([categoria])
}

model OrdemServico {
  id                  String             @id @default(cuid())
  numero              String             @unique
  placa               String
  veiculoMarca        String?
  veiculoModelo       String?
  veiculoAno          Int?
  veiculoCor          String?
  kmEntrada           Int
  clienteNome         String
  clienteTelefone     String?
  clienteCpfCnpj      String?
  // Opcionais - a OS continua aceitando cliente/veiculo digitado avulso (o
  // texto acima) sem exigir cadastro, pra nao travar atendimento de balcao.
  // Quando um cadastro e selecionado no formulario, esses dois ficam
  // preenchidos e habilitam historico de verdade por cliente/placa.
  // onDelete SetNull: apagar o cadastro nao pode apagar a OS (historico real).
  clienteId           String?
  veiculoId           String?
  // Legado: um unico mecanico digitado a mao. Substituido por `responsaveis`
  // (varias pessoas, ligadas ao cadastro de Funcionario quando existir).
  // Mantido so para nao perder o historico ja gravado; nada mais escreve aqui.
  mecanicoResponsavel String?
  dataEntrada         DateTime           @default(now())
  dataPrevisaoEntrega DateTime?
  dataSaida           DateTime?
  problemaRelatado    String?
  diagnostico         String?
  codigoFalha         String?
  sistemaAfetado      String?
  servicosRealizados  String?
  status              String             @default("aberto")
  valorMaoDeObra      Float              @default(0)
  valorPecas          Float              @default(0)
  desconto            Float              @default(0)
  valorTotal          Float              @default(0)
  formaPagamento      String?
  garantiaDias        Int?
  observacoes         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  itens               ItemOrdemServico[]
  responsaveis        ResponsavelOS[]
  cliente             Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  veiculo             Veiculo?           @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  @@index([placa])
  @@index([status])
  @@index([clienteId])
  @@index([veiculoId])
}

// Cadastro de cliente/veiculo reaproveitavel entre ordens de servico -
// independente do login (Google): a maioria dos clientes de balcao nunca
// vai logar no site, entao isso nao se liga a User de proposito.
model Cliente {
  id        String         @id @default(cuid())
  nome      String
  telefone  String?
  cpfCnpj   String?
  email     String?
  createdAt DateTime       @default(now())
  veiculos  Veiculo[]
  ordens    OrdemServico[]

  @@index([nome])
  @@index([telefone])
}

model Veiculo {
  id        String         @id @default(cuid())
  clienteId String
  placa     String
  marca     String?
  modelo    String?
  ano       Int?
  cor       String?
  createdAt DateTime       @default(now())
  cliente   Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordens    OrdemServico[]

  @@index([clienteId])
  @@index([placa])
}

model ItemOrdemServico {
  id             String       @id @default(cuid())
  ordemServicoId String
  produtoId      String
  quantidade     Int
  valorUnitario  Float
  valorTotal     Float
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  produto        Produto      @relation(fields: [produtoId], references: [id])

  @@index([ordemServicoId])
  @@index([produtoId])
}

// Quem trabalhou na OS. Uma OS pode ter varias pessoas, e cada pessoa pode ou
// nao estar no cadastro de Funcionario - mecanico terceirizado, ajudante do dia
// ou quem ainda nao foi cadastrado entram so pelo nome, sem travar o
// atendimento (mesma logica de cliente avulso na OS).
// `nome` e sempre gravado como snapshot: se o funcionario for excluido do
// cadastro depois, a OS continua mostrando quem fez o servico.
model ResponsavelOS {
  id             String       @id @default(cuid())
  ordemServicoId String
  funcionarioId  String?
  nome           String
  createdAt      DateTime     @default(now())
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  funcionario    Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)

  @@index([ordemServicoId])
  @@index([funcionarioId])
}

model MercadoLivreToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VeiculoCompativel {
  id          String  @id @default(cuid())
  produtoId   String
  montadora   String
  modelo      String
  versaoMotor String
  anoInicial  Int
  anoFinal    Int?
  posicao     String
  observacao  String?
  produto     Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
}

model Fornecedor {
  id                      String           @id @default(cuid())
  razaoSocial             String
  nomeFantasia            String
  cnpj                    String           @unique
  inscricaoEstadual       String?
  contato                 String?
  telefone                String?
  email                   String?
  enderecoLogradouro      String
  enderecoNumero          String
  enderecoComplemento     String?
  enderecoBairro          String
  enderecoCidade          String
  enderecoEstado          String
  enderecoCep             String
  dadosBancariosBanco     String
  dadosBancariosAgencia   String
  dadosBancariosConta     String
  dadosBancariosTipoConta String
  condicaoPagamentoPadrao String?
  prazoEntrega            Int?
  avaliacao               Int?
  observacoes             String?
  createdAt               DateTime         @default(now())
  entradasEstoque         EntradaEstoque[]
}

model Gasto {
  id             String    @id @default(cuid())
  descricao      String
  categoria      String
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  formaPagamento String?
  status         String    @default("pendente")
  recorrente     Boolean   @default(false)
  observacoes    String?
  createdAt      DateTime  @default(now())

  @@map("gastos")
}

model Funcionario {
  id                 String    @id @default(cuid())
  nome               String
  cpf                String    @unique
  cargo              String
  setor              String
  telefone           String?
  email              String?
  dataAdmissao       DateTime
  dataDemissao       DateTime?
  salario            Float?
  comissaoPercentual Float?    @default(0)
  tipoContrato       String
  status             String    @default("ativo")
  endereco           String?
  observacoes        String?
  createdAt          DateTime  @default(now())
  ordensServico      ResponsavelOS[]
}

model SaidaEstoque {
  id              String                   @id @default(cuid())
  tipoSaida       String
  numeroPedido    String?
  dataHora        DateTime
  cliente         String?
  cpfCnpjCliente  String?
  vendedor        String?
  subtotal        Float?
  descontoTotal   Float?
  valorFinal      Float?
  formasPagamento String?
  troco           Float?
  observacoes     String?
  emitirNFe       Boolean?
  imprimirCupom   Boolean?
  createdAt       DateTime                 @default(now())
  itens           ItemMovimentacao_saida[]
}

model EntradaEstoque {
  id                String                     @id @default(cuid())
  numeroNF          String
  chaveAcesso       String                     @unique
  dataEmissao       DateTime
  dataEntrada       DateTime
  fornecedorId      String
  cnpjFornecedor    String
  tipoEntrada       String
  condicaoPagamento String?
  dataVencimento    DateTime?
  formaPagamento    String?
  subtotalProdutos  Float?
  totalDescontos    Float?
  totalFrete        Float?
  totalIPI          Float?
  totalICMSST       Float?
  outrasDespesas    Float?
  valorTotal        Float?
  observacoes       String?
  anexoUrl          String?
  createdAt         DateTime                   @default(now())
  fornecedor        Fornecedor                 @relation(fields: [fornecedorId], references: [id])
  itens             ItemMovimentacao_entrada[]
}

model ItemMovimentacao_saida {
  id            String       @id @default(cuid())
  produtoId     String
  saidaId       String
  quantidade    Int
  unidade       String?
  valorUnitario Float
  desconto      Float?
  ipi           Float?
  icms          Float?
  valorTotal    Float
  saida         SaidaEstoque @relation(fields: [saidaId], references: [id], onDelete: Cascade)
  produto       Produto      @relation(fields: [produtoId], references: [id])

  @@index([produtoId])
  @@index([saidaId])
}

model ItemMovimentacao_entrada {
  id            String         @id @default(cuid())
  produtoId     String
  entradaId     String
  quantidade    Int
  unidade       String?
  valorUnitario Float
  desconto      Float?
  ipi           Float?
  icms          Float?
  valorTotal    Float
  entrada       EntradaEstoque @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  produto       Produto        @relation(fields: [produtoId], references: [id])

  @@index([produtoId])
  @@index([entradaId])
}

// Mensagens do formulario de contato da loja publica - inclui pedidos
// encaminhados pelo carrinho (o site nao tem checkout/pagamento de verdade,
// entao "Finalizar Pedido" vira uma solicitacao de contato real).
model MensagemContato {
  id        String   @id @default(cuid())
  nome      String
  email     String
  telefone  String?
  assunto   String?
  veiculo   String?
  mensagem  String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lida])
}

// --- Autenticacao (Auth.js) e perfis de acesso ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // "cliente" (padrao), "funcionario" ou "admin" - promovido manualmente
  // por um admin em /admin/usuarios (ou via ADMIN_EMAILS no primeiro login).
  role          String    @default("cliente")
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Preferencias do sistema em chave/valor (JSON no valor). Ex.: margens de
// lucro padrao usadas no cadastro de produto.
model Configuracao {
  chave     String   @id
  valor     String
  updatedAt DateTime @updatedAt
}

// Avisos que o Mercado Livre manda (vendas, perguntas, anuncios). Guardados
// para nao processar o mesmo duas vezes e para ter historico do que chegou.
model NotificacaoMercadoLivre {
  id         String   @id @default(cuid())
  topico     String
  recurso    String
  processada Boolean  @default(false)
  resultado  String?
  createdAt  DateTime @default(now())

  @@index([topico, recurso])
}
